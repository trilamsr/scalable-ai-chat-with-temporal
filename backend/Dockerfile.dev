# Development Dockerfile for Backend
FROM node:18-alpine

WORKDIR /app

# Copy and install shared dependencies first
COPY shared/package*.json ./shared/
WORKDIR /app/shared
RUN npm install

# Copy shared source files
COPY shared/src ./src
COPY shared/tsconfig.json ./

# Switch back to /app and copy backend package files
WORKDIR /app
COPY backend/package*.json ./backend/
COPY backend/tsconfig.json ./backend/

# Install backend dependencies
WORKDIR /app/backend
RUN npm install

# Copy backend source files
COPY backend/src ./src

# Expose the WebSocket server port
EXPOSE 4000

# Run with nodemon for hot-reloading
CMD ["npm", "run", "dev"]
