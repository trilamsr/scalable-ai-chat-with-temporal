# Development Dockerfile for Backend
FROM node:18-alpine

WORKDIR /app

# Copy root package.json for workspace configuration
COPY package.json ./

# Copy package files for all workspaces
COPY shared/package*.json ./shared/
COPY backend/package*.json ./backend/

# Install all dependencies (workspaces will be linked automatically)
RUN npm install

# Copy shared source and config
COPY shared/src ./shared/src
COPY shared/tsconfig.json ./shared/

# Copy backend source and config
COPY backend/src ./backend/src
COPY backend/tsconfig.json ./backend/

# Expose the WebSocket server port
EXPOSE 4000

# Set working directory to backend
WORKDIR /app/backend

# Run with nodemon for hot-reloading
CMD ["npm", "run", "dev"]
