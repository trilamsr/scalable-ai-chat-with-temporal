# Root .dockerignore for monorepo builds
# This applies when building from root context

# Dependencies
node_modules
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output (keep these out for multi-stage builds)
dist
build
**/dist
**/build
*.tsbuildinfo

# Environment files (never copy env vars into image)
.env
.env.*
!.env.example

# Testing
coverage
**/coverage
.nyc_output
*.test.ts
*.test.tsx
*.test.js
*.spec.ts
*.spec.tsx
*.spec.js
**/__tests__
**/__mocks__

# IDE
.vscode
.idea
*.swp
*.swo
*~
.claude

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
*~

# Git
.git
.gitignore
.gitattributes
.github

# Docker
Dockerfile*
.dockerignore
**/Dockerfile*
**/.dockerignore
docker-compose*.yml

# Documentation
README.md
**/*.md
!shared/**/*.md
LICENSE
CHANGELOG.md

# Logs
*.log
.cache
logs

# Development files
.prettierrc*
.eslintrc*
.editorconfig
.nvmrc
.npmrc
Makefile
*.config.js
!tailwind.config.js
!postcss.config.js

# Misc
tmp
temp
*.tmp
