# syntax=docker/dockerfile:1.4
# Frontend Development Dockerfile - Optimized for monorepo with hot-reloading

FROM node:18-alpine

# Install additional tools for development
RUN apk add --no-cache git

WORKDIR /app

# Copy root package.json for workspace configuration
COPY package.json ./

# Copy package files for all workspaces
COPY shared/package*.json ./shared/
COPY frontend/package*.json ./frontend/

# Install all dependencies with cache mount for faster rebuilds
RUN --mount=type=cache,target=/root/.npm \
    npm install

# Copy shared config and source
COPY shared/tsconfig.json ./shared/
COPY shared/src ./shared/src

# Build shared package so it's available for imports
RUN npm run build --workspace=shared

# Note: Frontend files are mounted as volumes via docker-compose for hot-reloading:
# - frontend/src, index.html, vite.config.ts, tsconfig.json
# - tailwind.config.js, postcss.config.js, .env
# The volumes will override any COPY commands, so we don't copy them here

# Expose Vite dev server port
EXPOSE 3000

# Set working directory to frontend
WORKDIR /app/frontend

# Start Vite development server
CMD ["npm", "run", "dev"]
