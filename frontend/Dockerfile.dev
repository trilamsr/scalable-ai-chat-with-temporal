# syntax=docker/dockerfile:1.4
# Frontend Development Dockerfile - Optimized for monorepo with hot-reloading

FROM node:18-alpine

# Install additional tools for development
RUN apk add --no-cache git

WORKDIR /app

# Copy root package.json for workspace configuration
COPY package.json ./

# Copy package files for all workspaces
COPY shared/package*.json ./shared/
COPY frontend/package*.json ./frontend/

# Install all dependencies with cache mount for faster rebuilds
RUN --mount=type=cache,target=/root/.npm \
    npm install --legacy-peer-deps

# Copy shared config and source
COPY shared/tsconfig.json ./shared/
COPY shared/src ./shared/src

# Build shared package so it's available for imports
RUN npm run build --workspace=shared

# Note: All frontend files are mounted as volumes via docker-compose:
# - frontend/src, frontend/public
# - frontend/tsconfig.json, tailwind.config.js, postcss.config.js
# The volumes will override any COPY commands, so we don't copy them here

# Expose React dev server port
EXPOSE 3000

# Set working directory to frontend
WORKDIR /app/frontend

# Use node user for better security (optional in dev, but good practice)
USER node

# Start React development server
CMD ["npm", "start"]
